// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String            @id @default(cuid())
  name              String
  email             String            @unique
  password          String
  role              String            @default("MEMBER") // SaaS global role: ADMIN or MEMBER
  avatarUrl         String?
  phone             String?
  title             String?           @default("Sales Executive")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  otpCodes          OtpCode[]
  workspaceMembers  WorkspaceMember[]
  companies         Company[]
  contacts          Contact[]
  deals             Deal[]
  tasks             Task[]
  activityLogs      ActivityLog[]
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  plan        String            @default("FREE")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  members     WorkspaceMember[]
  companies   Company[]
  contacts    Contact[]
  deals       Deal[]
  tasks       Task[]
  activityLogs ActivityLog[]
}

model WorkspaceMember {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String     @default("OWNER") // OWNER, ADMIN, MEMBER
  createdAt   DateTime   @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String
  purpose    String    @default("VERIFICATION") // VERIFICATION, PASSWORD_RESET
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([purpose])
}

model Company {
  id            String     @id @default(cuid())
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  domain        String?
  industry      String?    @default("Technology")
  size          String?    @default("50-200")
  phone         String?
  address       String?
  website       String?
  annualRevenue Float?     @default(0)
  ownerId       String
  owner         User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  contacts      Contact[]
  deals         Deal[]

  @@index([workspaceId])
  @@index([ownerId])
}

model Contact {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String?
  title       String?    @default("Decision Maker")
  status      String     @default("ACTIVE") // ACTIVE, LEAD, CHURNED
  avatarUrl   String?
  companyId   String?
  company     Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  deals       Deal[]
  tasks       Task[]

  @@index([workspaceId])
  @@index([ownerId])
  @@index([companyId])
}

model Deal {
  id                String     @id @default(cuid())
  workspaceId       String
  workspace         Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title             String
  value             Float      @default(0)
  stage             String     @default("LEAD") // LEAD, QUALIFIED, DEMO, PROPOSAL, NEGOTIATION, WON, LOST
  probability       Int        @default(20)
  expectedCloseDate DateTime?
  companyId         String?
  company           Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId         String?
  contact           Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId           String
  owner             User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  tasks             Task[]

  @@index([workspaceId])
  @@index([ownerId])
  @@index([companyId])
  @@index([contactId])
  @@index([stage])
}

model Task {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  priority    String     @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status      String     @default("TODO")   // TODO, IN_PROGRESS, DONE
  dealId      String?
  deal        Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contactId   String?
  contact     Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([workspaceId])
  @@index([ownerId])
  @@index([dealId])
  @@index([contactId])
}

model ActivityLog {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type        String     @default("NOTE") // NOTE, CALL, MEETING, EMAIL, STAGE_CHANGE
  note        String
  relatedType String?    // DEAL, CONTACT, COMPANY, TASK
  relatedId   String?
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@index([workspaceId])
  @@index([userId])
  @@index([relatedType, relatedId])
}
